{
    "content": ":root {\n  /* Color Palette - Modern & Clean */\n  --primary-color: #6366f1; /* Indigo 500 */\n  --primary-hover: #4f46e5; /* Indigo 600 */\n  --secondary-color: #ec4899; /* Pink 500 */\n  --accent-color: #8b5cf6; /* Violet 500 */\n  \n  /* Backgrounds */\n  --bg-gradient: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);\n  --surface-color: rgba(255, 255, 255, 0.9);\n  --surface-hover: rgba(255, 255, 255, 1);\n  --glass-bg: rgba(255, 255, 255, 0.7);\n  --glass-border: rgba(255, 255, 255, 0.5);\n  \n  /* Text */\n  --text-primary: #1f2937; /* Gray 800 */\n  --text-secondary: #4b5563; /* Gray 600 */\n  --text-light: #9ca3af; /* Gray 400 */\n  \n  /* UI Elements */\n  --border-radius-sm: 8px;\n  --border-radius-md: 12px;\n  --border-radius-lg: 20px;\n  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);\n  --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);\n  --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);\n  --shadow-glass: 0 8px 32px 0 rgba(31, 38, 135, 0.15);\n  \n  /* Spacing */\n  --spacing-xs: 0.5rem;\n  --spacing-sm: 0.75rem;\n  --spacing-md: 1rem;\n  --spacing-lg: 1.5rem;\n  --spacing-xl: 2rem;\n  \n  /* Transitions */\n  --transition-fast: 0.2s ease;\n  --transition-normal: 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n}\n\n* {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\n\nbody {\n  font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;\n  background: var(--bg-gradient);\n  background-attachment: fixed; /* Full page gradient */\n  color: var(--text-primary);\n  min-height: 100vh;\n  line-height: 1.6;\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n}\n\n/* Scrollbar Styling */\n::-webkit-scrollbar {\n  width: 8px;\n  height: 8px;\n}\n\n::-webkit-scrollbar-track {\n  background: transparent;\n}\n\n::-webkit-scrollbar-thumb {\n  background: #cbd5e1;\n  border-radius: 4px;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: #94a3b8;\n}\n\n/* Typography */\nh1, h2, h3, h4, h5, h6 {\n  color: var(--text-primary);\n  font-weight: 700;\n  line-height: 1.2;\n  margin-bottom: var(--spacing-md);\n}\n\nh1 {\n  font-size: 2.5rem;\n  background: linear-gradient(to right, var(--primary-color), var(--secondary-color));\n  -webkit-background-clip: text;\n  background-clip: text;\n  color: transparent;\n  display: inline-block;\n}\n\np {\n  margin-bottom: var(--spacing-md);\n  color: var(--text-secondary);\n}\n\n/* Interactive Elements */\nbutton {\n  cursor: pointer;\n  border: none;\n  background-color: var(--primary-color);\n  color: white;\n  padding: var(--spacing-sm) var(--spacing-lg);\n  border-radius: var(--border-radius-sm);\n  font-weight: 600;\n  font-size: 0.95rem;\n  transition: all var(--transition-normal);\n  box-shadow: var(--shadow-sm);\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--spacing-xs);\n}\n\nbutton:hover {\n  background-color: var(--primary-hover);\n  transform: translateY(-1px);\n  box-shadow: var(--shadow-md);\n}\n\nbutton:active {\n  transform: translateY(0);\n}\n\nbutton.secondary {\n  background-color: white;\n  color: var(--text-primary);\n  border: 1px solid #e5e7eb;\n}\n\nbutton.secondary:hover {\n  background-color: #f9fafb;\n  border-color: #d1d5db;\n}\n\ninput[type=\"text\"],\ninput[type=\"search\"],\ntextarea,\nselect {\n  width: 100%;\n  padding: var(--spacing-sm) var(--spacing-md);\n  border: 1px solid rgba(0, 0, 0, 0.1);\n  border-radius: var(--border-radius-sm);\n  background: rgba(255, 255, 255, 0.8);\n  color: var(--text-primary);\n  font-family: inherit;\n  transition: all var(--transition-fast);\n  backdrop-filter: blur(4px);\n}\n\ninput:focus,\ntextarea:focus,\nselect:focus {\n  outline: none;\n  border-color: var(--primary-color);\n  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);\n  background: white;\n}\n\n/* Utility Classes */\n.glass-panel {\n  background: var(--glass-bg);\n  backdrop-filter: blur(12px);\n  -webkit-backdrop-filter: blur(12px);\n  border: 1px solid var(--glass-border);\n  border-radius: var(--border-radius-md);\n  box-shadow: var(--shadow-glass);\n}\n\n.flex-center {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.container {\n  max-width: 1200px;\n  margin: 0 auto;\n  padding: 0 var(--spacing-md);\n}\n\n/* Code/JSON Styling */\npre {\n  font-family: 'Fira Code', 'JetBrains Mono', Consolas, monospace;\n  font-size: 0.9rem;\n}\n",
    "file_path": "/testbed/json-viewer/src/index.css"
}

/testbed/json-viewer/src/App.jsx
{
    "content": "import React, { useState } from 'react';\nimport './styles/App.css';\nimport TreeView from './components/TreeView';\nimport ListView from './components/ListView';\nimport EditorView from './components/EditorView';\nimport DataPreview from './components/DataPreview';\n\nfunction App() {\n  const [jsonData, setJsonData] = useState(null);\n  const [currentView, setCurrentView] = useState('tree');\n  const [error, setError] = useState(null);\n\n  const handleFileUpload = (event) => {\n    const file = event.target.files[0];\n    if (file) {\n      const reader = new FileReader();\n      reader.onload = (e) => {\n        try {\n          const data = JSON.parse(e.target.result);\n          setJsonData(data);\n          setError(null);\n        } catch (err) {\n          setError('无效的JSON文件');\n          setJsonData(null);\n        }\n      };\n      reader.readAsText(file);\n    }\n  };\n\n  const handleJsonInput = (jsonString) => {\n    try {\n      const data = JSON.parse(jsonString);\n      setJsonData(data);\n      setError(null);\n    } catch (err) {\n      setError('无效的JSON格式');\n    }\n  };\n\n  const renderCurrentView = () => {\n    if (!jsonData) return null;\n\n    switch (currentView) {\n      case 'tree':\n        return <TreeView data={jsonData} />;\n      case 'list':\n        return <ListView data={jsonData} />;\n      case 'editor':\n        return <EditorView data={jsonData} onJsonChange={handleJsonInput} />;\n      default:\n        return <TreeView data={jsonData} />;\n    }\n  };\n\n  return (\n    <div className=\"app-container\">\n      <header className=\"app-header\">\n        <div className=\"logo-container\">\n          <span className=\"logo-icon\">{ }</span>\n          <h1>JSON Viewer</h1>\n        </div>\n        <p className=\"subtitle\">现代化的 JSON 数据可视化工具</p>\n      </header>\n\n      <main className=\"main-content\">\n        <div className=\"glass-panel viewer-card\">\n          <div className=\"controls-bar\">\n            <div className=\"view-toggles\">\n              <button\n                className={`toggle-btn ${currentView === 'tree' ? 'active' : ''}`}\n                onClick={() => setCurrentView('tree')}\n              >\n                树状视图\n              </button>\n              <button\n                className={`toggle-btn ${currentView === 'list' ? 'active' : ''}`}\n                onClick={() => setCurrentView('list')}\n              >\n                列表视图\n              </button>\n              <button\n                className={`toggle-btn ${currentView === 'editor' ? 'active' : ''}`}\n                onClick={() => setCurrentView('editor')}\n              >\n                编辑器\n              </button>\n            </div>\n\n            <div className=\"actions\">\n              <label className=\"upload-btn primary\">\n                <span>上传文件</span>\n                <input\n                  type=\"file\"\n                  accept=\".json\"\n                  onChange={handleFileUpload}\n                  style={{ display: 'none' }}\n                />\n              </label>\n            </div>\n          </div>\n\n          {error && (\n            <div className=\"error-banner\">\n              <span className=\"error-icon\">⚠️</span>\n              {error}\n            </div>\n          )}\n\n          <div className=\"content-area\">\n            {!jsonData && !error && (\n              <div className=\"empty-state\">\n                <div className=\"empty-icon\">📂</div>\n                <h3>开始使用</h3>\n                <p>上传 JSON 文件</p>\n                <label className=\"upload-btn large\">\n                  选择文件\n                  <input\n                    type=\"file\"\n                    accept=\".json\"\n                    onChange={handleFileUpload}\n                    style={{ display: 'none' }}\n                  />\n                </label>\n              </div>\n            )}\n\n            {jsonData && (\n              <>\n                <div className=\"view-viewport custom-scrollbar\">\n                  {renderCurrentView()}\n                </div>\n                <div className=\"data-preview-sidebar\">\n                  <DataPreview data={jsonData} />\n                </div>\n              </>\n            )}\n          </div>\n        </div>\n      </main>\n\n      <footer className=\"app-footer\">\n        <p>JSON Viewer Tool © 2024</p>\n      </footer>\n    </div>\n  );\n}\n\nexport default App;\n",
    "file_path": "/testbed/json-viewer/src/App.jsx"
}

/testbed/json-viewer/src/styles/App.css
{
    "content": "/* App Container */\n.app-container {\n  display: flex;\n  flex-direction: column;\n  min-height: 100vh;\n  padding: var(--spacing-md);\n  max-width: 1400px;\n  margin: 0 auto;\n}\n\n/* Header */\n.app-header {\n  margin-bottom: var(--spacing-lg);\n  text-align: center;\n  padding: var(--spacing-md) 0;\n}\n\n.logo-container {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--spacing-sm);\n  margin-bottom: var(--spacing-xs);\n}\n\n.logo-icon {\n  font-size: 2rem;\n  background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));\n  -webkit-background-clip: text;\n  background-clip: text;\n  color: transparent;\n}\n\n.subtitle {\n  font-size: 1.1rem;\n  color: var(--text-secondary);\n  font-weight: 400;\n}\n\n/* Main Content */\n.main-content {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n}\n\n.viewer-card {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  padding: var(--spacing-lg);\n  min-height: 600px;\n  overflow: hidden;\n}\n\n/* Controls Bar */\n.controls-bar {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: var(--spacing-lg);\n  padding-bottom: var(--spacing-md);\n  border-bottom: 1px solid rgba(0, 0, 0, 0.05);\n  flex-wrap: wrap;\n  gap: var(--spacing-md);\n}\n\n.view-toggles {\n  display: flex;\n  background: rgba(0, 0, 0, 0.05);\n  padding: 4px;\n  border-radius: var(--border-radius-sm);\n  gap: 2px;\n}\n\n.toggle-btn {\n  background: transparent;\n  color: var(--text-secondary);\n  padding: var(--spacing-xs) var(--spacing-md);\n  font-size: 0.9rem;\n  border-radius: 6px;\n  box-shadow: none;\n}\n\n.toggle-btn:hover {\n  background: rgba(255, 255, 255, 0.5);\n  transform: none;\n  color: var(--text-primary);\n}\n\n.toggle-btn.active {\n  background: white;\n  color: var(--primary-color);\n  box-shadow: var(--shadow-sm);\n  font-weight: 600;\n}\n\n.upload-btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  cursor: pointer;\n  transition: all var(--transition-normal);\n}\n\n.upload-btn.primary {\n  background: var(--primary-color);\n  color: white;\n  padding: var(--spacing-sm) var(--spacing-lg);\n  border-radius: var(--border-radius-sm);\n  font-weight: 600;\n  box-shadow: var(--shadow-sm);\n}\n\n.upload-btn.primary:hover {\n  background: var(--primary-hover);\n  transform: translateY(-1px);\n  box-shadow: var(--shadow-md);\n}\n\n/* Content Area */\n.content-area {\n  flex: 1;\n  display: flex;\n  gap: var(--spacing-lg);\n  overflow: hidden;\n  position: relative;\n}\n\n.view-viewport {\n  flex: 2;\n  overflow-y: auto;\n  padding-right: var(--spacing-sm);\n  background: rgba(255, 255, 255, 0.4);\n  border-radius: var(--border-radius-sm);\n  border: 1px solid rgba(255, 255, 255, 0.2);\n}\n\n.data-preview-sidebar {\n  flex: 1;\n  min-width: 300px;\n  max-width: 400px;\n  background: rgba(255, 255, 255, 0.5);\n  border-radius: var(--border-radius-sm);\n  padding: var(--spacing-md);\n  overflow-y: auto;\n  border: 1px solid rgba(255, 255, 255, 0.2);\n}\n\n/* Empty State */\n.empty-state {\n  width: 100%;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  text-align: center;\n  color: var(--text-secondary);\n  padding: var(--spacing-xl);\n  border: 2px dashed rgba(0, 0, 0, 0.1);\n  border-radius: var(--border-radius-md);\n  background: rgba(255, 255, 255, 0.2);\n}\n\n.empty-icon {\n  font-size: 4rem;\n  margin-bottom: var(--spacing-md);\n  opacity: 0.5;\n}\n\n.upload-btn.large {\n  margin-top: var(--spacing-lg);\n  background: white;\n  color: var(--primary-color);\n  border: 1px solid var(--primary-color);\n  padding: var(--spacing-md) var(--spacing-xl);\n  border-radius: var(--border-radius-md);\n  font-size: 1.1rem;\n}\n\n.upload-btn.large:hover {\n  background: var(--primary-color);\n  color: white;\n}\n\n/* Error Banner */\n.error-banner {\n  background: #fee2e2;\n  color: #b91c1c;\n  padding: var(--spacing-md);\n  border-radius: var(--border-radius-sm);\n  margin-bottom: var(--spacing-md);\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-sm);\n  border: 1px solid #fecaca;\n}\n\n/* Footer */\n.app-footer {\n  text-align: center;\n  padding: var(--spacing-lg) 0;\n  color: var(--text-light);\n  font-size: 0.9rem;\n}\n\n/* Responsive */\n@media (max-width: 768px) {\n  .content-area {\n    flex-direction: column;\n  }\n\n  .data-preview-sidebar {\n    max-width: none;\n    min-height: 200px;\n  }\n\n  .controls-bar {\n    flex-direction: column;\n    align-items: stretch;\n  }\n\n  .view-toggles {\n    justify-content: center;\n  }\n\n  .upload-btn.primary {\n    width: 100%;\n    text-align: center;\n  }\n}\n\n/* Tree View */\n.tree-view {\n  font-family: 'Fira Code', monospace;\n  font-size: 0.9rem;\n  line-height: 1.6;\n}\n\n.tree-node {\n  margin-left: var(--spacing-md);\n}\n\n.node-header {\n  display: flex;\n  align-items: center;\n  cursor: pointer;\n  padding: 2px 4px;\n  border-radius: 4px;\n  transition: background-color var(--transition-fast);\n}\n\n.node-header:hover {\n  background-color: rgba(0, 0, 0, 0.05);\n}\n\n.node-toggle {\n  display: inline-block;\n  width: 16px;\n  height: 16px;\n  margin-right: 6px;\n  font-size: 0.7rem;\n  transition: transform var(--transition-fast);\n  color: var(--text-light);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.node-toggle.open {\n  transform: rotate(90deg);\n}\n\n.node-key {\n  color: var(--text-primary);\n  margin-right: 6px;\n  font-weight: 500;\n}\n\n.children {\n  border-left: 1px solid rgba(0, 0, 0, 0.05);\n  margin-left: 7px;\n}\n\n/* Value Types */\n.value-string {\n  color: #10b981;\n}\n\n/* Emerald 500 */\n.value-number {\n  color: #f59e0b;\n}\n\n/* Amber 500 */\n.value-boolean {\n  color: #ef4444;\n}\n\n/* Red 500 */\n.value-null {\n  color: #9ca3af;\n  font-style: italic;\n}\n\n/* Gray 400 */\n\n/* List View */\n.list-view {\n  font-family: 'Fira Code', monospace;\n  font-size: 0.9rem;\n}\n\n.list-item {\n  padding: var(--spacing-xs) var(--spacing-sm);\n  border-bottom: 1px solid rgba(0, 0, 0, 0.05);\n  display: flex;\n  align-items: baseline;\n}\n\n.list-item:hover {\n  background-color: rgba(255, 255, 255, 0.5);\n}\n\n.list-item .node-key {\n  color: var(--text-secondary);\n  margin-right: var(--spacing-md);\n  min-width: 120px;\n}\n\n/* Editor View */\n.editor-container {\n  position: relative;\n  height: 100%;\n  display: flex;\n  flex-direction: column;\n}\n\n.json-input {\n  flex: 1;\n  width: 100%;\n  height: 100%;\n  padding: var(--spacing-md);\n  border: 1px solid rgba(0, 0, 0, 0.1);\n  border-radius: var(--border-radius-sm);\n  font-family: 'Fira Code', monospace;\n  font-size: 0.9rem;\n  resize: none;\n  background: rgba(255, 255, 255, 0.6);\n  transition: all var(--transition-fast);\n}\n\n.json-input:focus {\n  background: white;\n  outline: none;\n  border-color: var(--primary-color);\n  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);\n}\n\n.format-btn {\n  position: absolute;\n  top: var(--spacing-sm);\n  right: var(--spacing-sm);\n  padding: 4px 12px;\n  background: rgba(99, 102, 241, 0.1);\n  color: var(--primary-color);\n  border: 1px solid rgba(99, 102, 241, 0.2);\n  border-radius: var(--border-radius-sm);\n  font-size: 0.8rem;\n  cursor: pointer;\n  transition: all var(--transition-fast);\n  backdrop-filter: blur(4px);\n  z-index: 999;\n}\n\n.format-btn:hover {\n  background: var(--primary-color);\n  color: white;\n}\n\n/* Data Preview Sidebar */\n.data-preview h3 {\n  font-size: 1.1rem;\n  margin-bottom: var(--spacing-md);\n  color: var(--text-primary);\n  border-bottom: 2px solid var(--primary-color);\n  padding-bottom: var(--spacing-xs);\n  display: inline-block;\n}\n\n.data-stats {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));\n  gap: var(--spacing-md);\n}\n\n.stat-item {\n  background: white;\n  padding: var(--spacing-md);\n  border-radius: var(--border-radius-sm);\n  box-shadow: var(--shadow-sm);\n  text-align: center;\n  transition: transform var(--transition-fast);\n}\n\n.stat-item:hover {\n  transform: translateY(-2px);\n  box-shadow: var(--shadow-md);\n}\n\n.stat-label {\n  font-size: 0.8rem;\n  color: var(--text-secondary);\n  margin-bottom: 4px;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n.stat-value {\n  font-size: 1.5rem;\n  font-weight: 700;\n  color: var(--primary-color);\n}",
    "file_path": "/testbed/json-viewer/src/styles/App.css"
}

/testbed/json-viewer/src/components/EditorView.jsx
{
    "content": "import React, { useState, useEffect } from 'react';\n\nconst EditorView = ({ data, onJsonChange }) => {\n  const [jsonString, setJsonString] = useState('');\n\n  useEffect(() => {\n    if (data) {\n      setJsonString(JSON.stringify(data, null, 2));\n    }\n  }, [data]);\n\n  const handleChange = (event) => {\n    const value = event.target.value;\n    setJsonString(value);\n  };\n\n  const handleBlur = () => {\n    onJsonChange(jsonString);\n  };\n\n  const handleFormat = () => {\n    try {\n      const parsed = JSON.parse(jsonString);\n      const formatted = JSON.stringify(parsed, null, 2);\n      setJsonString(formatted);\n      onJsonChange(formatted);\n    } catch (error) {\n      alert('无效的JSON格式，无法格式化');\n    }\n  };\n\n  return (\n    <div className=\"editor-container\">\n      <button\n        onClick={handleFormat}\n        className=\"format-btn\"\n      >\n        格式化\n      </button>\n      <textarea\n        className=\"json-input\"\n        value={jsonString}\n        onChange={handleChange}\n        onBlur={handleBlur}\n        placeholder=\"请输入JSON数据...\"\n      />\n    </div>\n  );\n};\n\nexport default EditorView;",
    "file_path": "/testbed/json-viewer/src/components/EditorView.jsx"
}

/testbed/json-viewer/src/main.jsx
{
    "content": "import { StrictMode } from 'react'\nimport { createRoot } from 'react-dom/client'\nimport './index.css'\nimport App from './App.jsx'\n\ncreateRoot(document.getElementById('root')).render(\n  <StrictMode>\n    <App />\n  </StrictMode>,\n)\n",
    "file_path": "/testbed/json-viewer/src/main.jsx"
}

/testbed/json-viewer/src/components/DataPreview.jsx
{
    "content": "import React from 'react';\n\nconst DataPreview = ({ data }) => {\n  const analyzeData = (obj) => {\n    const stats = {\n      totalItems: 0,\n      strings: 0,\n      numbers: 0,\n      booleans: 0,\n      nulls: 0,\n      arrays: 0,\n      objects: 0,\n      maxDepth: 0\n    };\n\n    const traverse = (item, depth = 1) => {\n      stats.totalItems++;\n      \n      if (depth > stats.maxDepth) {\n        stats.maxDepth = depth;\n      }\n\n      if (item === null) {\n        stats.nulls++;\n        return;\n      }\n\n      const type = typeof item;\n\n      if (type === 'string') {\n        stats.strings++;\n      } else if (type === 'number') {\n        stats.numbers++;\n      } else if (type === 'boolean') {\n        stats.booleans++;\n      } else if (Array.isArray(item)) {\n        stats.arrays++;\n        item.forEach(child => traverse(child, depth + 1));\n      } else if (type === 'object') {\n        stats.objects++;\n        Object.values(item).forEach(child => traverse(child, depth + 1));\n      }\n    };\n\n    traverse(obj);\n    return stats;\n  };\n\n  const stats = analyzeData(data);\n\n  return (\n    <div className=\"data-preview\">\n      <h3>数据预览</h3>\n      <div className=\"data-stats\">\n        <div className=\"stat-item\">\n          <div className=\"stat-label\">总项数</div>\n          <div className=\"stat-value\">{stats.totalItems}</div>\n        </div>\n        <div className=\"stat-item\">\n          <div className=\"stat-label\">字符串</div>\n          <div className=\"stat-value\">{stats.strings}</div>\n        </div>\n        <div className=\"stat-item\">\n          <div className=\"stat-label\">数字</div>\n          <div className=\"stat-value\">{stats.numbers}</div>\n        </div>\n        <div className=\"stat-item\">\n          <div className=\"stat-label\">布尔值</div>\n          <div className=\"stat-value\">{stats.booleans}</div>\n        </div>\n        <div className=\"stat-item\">\n          <div className=\"stat-label\">空值</div>\n          <div className=\"stat-value\">{stats.nulls}</div>\n        </div>\n        <div className=\"stat-item\">\n          <div className=\"stat-label\">数组</div>\n          <div className=\"stat-value\">{stats.arrays}</div>\n        </div>\n        <div className=\"stat-item\">\n          <div className=\"stat-label\">对象</div>\n          <div className=\"stat-value\">{stats.objects}</div>\n        </div>\n        <div className=\"stat-item\">\n          <div className=\"stat-label\">最大深度</div>\n          <div className=\"stat-value\">{stats.maxDepth}</div>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default DataPreview;",
    "file_path": "/testbed/json-viewer/src/components/DataPreview.jsx"
}

/testbed/json-viewer/src/components/ListView.jsx
{
    "content": "import React from 'react';\n\nconst ListView = ({ data }) => {\n  const flattenObject = (obj, prefix = '') => {\n    let flattened = [];\n\n    if (obj === null) {\n      flattened.push({ path: prefix, value: null, type: 'null' });\n      return flattened;\n    }\n\n    const type = typeof obj;\n\n    if (type !== 'object' || Array.isArray(obj)) {\n      let valueType = type;\n      if (Array.isArray(obj)) valueType = 'array';\n      if (obj === null) valueType = 'null';\n      \n      flattened.push({ \n        path: prefix, \n        value: obj, \n        type: valueType \n      });\n      return flattened;\n    }\n\n    for (let key in obj) {\n      if (obj.hasOwnProperty(key)) {\n        const newPrefix = prefix ? `${prefix}.${key}` : key;\n        flattened = flattened.concat(flattenObject(obj[key], newPrefix));\n      }\n    }\n\n    return flattened;\n  };\n\n  const formatValue = (value, type) => {\n    switch (type) {\n      case 'string':\n        return <span className=\"value-string\">\" {value} \"</span>;\n      case 'number':\n        return <span className=\"value-number\">{value}</span>;\n      case 'boolean':\n        return <span className=\"value-boolean\">{value.toString()}</span>;\n      case 'null':\n        return <span className=\"value-null\">null</span>;\n      case 'array':\n        return <span className=\"value-number\">[{value.length} items]</span>;\n      case 'object':\n        return <span className=\"value-number\">{Object.keys(value).length} keys</span>;\n      default:\n        return <span>{value}</span>;\n    }\n  };\n\n  const flattenedData = flattenObject(data);\n\n  return (\n    <div className=\"list-view\">\n      {flattenedData.map((item, index) => (\n        <div key={index} className=\"list-item\">\n          <span className=\"node-key\">{item.path}:</span>\n          <span className=\"node-value\"> {formatValue(item.value, item.type)}</span>\n        </div>\n      ))}\n    </div>\n  );\n};\n\nexport default ListView;",
    "file_path": "/testbed/json-viewer/src/components/ListView.jsx"
}

